# LinkkWork MCP Environment Configuration Example
# Copy this file to .agents/.env.mcp to configure local credentials

# PostgreSQL MCP Server Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=linkkwork_admin
POSTGRES_PASSWORD=linkkwork_secure_password
POSTGRES_DB=linkkwork_db
POSTGRES_SSL=false

# Redis Configuration for Dispatch Engine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Gateway Testing URL
LINKKWORK_API_URL=http://localhost:3000/api/v1
